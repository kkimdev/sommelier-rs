<?xml version="1.0" encoding="UTF-8"?>
<!--
  Source: Chromium third_party/wayland-protocols/unstable/remote-shell/
  remote-shell-unstable-v2.xml
  https://raw.githubusercontent.com/chromium/chromium/main/third_party/wayland-protocols/unstable/remote-shell/remote-shell-unstable-v2.xml
  Fetched: 2026-08-23

  This vendored definition intentionally keeps the complete request/event
  ordering for the two interfaces used by Sommelier. Wayland opcodes are
  positional: omitting an earlier request would change set_bounds_in_output
  from the ChromeOS opcode (37).
-->
<protocol name="remote_shell_unstable_v2">
  <copyright>
